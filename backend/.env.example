# SG Car Rent Backend Configuration

PROJECT_NAME=SG Car Rent API
API_V1_STR=/api/v1
SECRET_KEY=sg-car-rent-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase PostgreSQL Connection String
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
